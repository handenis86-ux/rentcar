                    <div class="news-items">
                                                <div class="news-item">
                            <img
                                    src="img/news/WkCYTXXSYpfufUVZwMnK5snTRrRvU19TLrcYWCFk.jpg"
                                    alt="car"
                                    class="news-item__img"
                            />
                            <div class="news-item__body">
                                <div class="news-item__content">
                                    <div class="news-item__date">
                                        <img
                                                src="https://api.rentcar.uz/frontend/assets/images/icons/calendar-red.svg"
                                                alt="date-icon"
                                                class="news-item__date-icon"
                                        />
                                        <span class="newsDate"> 06.04.2025</span>
                                    </div>
                                    <div class="news-item__title">
                                        Что нужно знать при аренде автомобиля
