<script>
    function openModalAuth(modalId) {
        const modal = document.getElementById(modalId);
        if (modal) {
            modal.style.display = "block";
        } else {
            console.error(`Модалка с id "${modalId}" не найдена.`);
        }
    }

    function closeModalAuth(modalId) {
        const modal = document.getElementById(modalId);
        if (modal) {
            modal.style.display = "none";
        } else {
            console.error(`Модалка с id "${modalId}" не найдена.`);
        }
    }

    function submitLogin() {
        const phone = document.getElementById('phone').value.replace(/\D/g, ''); // Убираем нечисловые символы
        const errorElement = document.getElementById('loginError');
        errorElement.textContent = '';

        fetch('/login', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-CSRF-TOKEN': document.querySelector('meta[name="csrf-token"]').content
                },
                body: JSON.stringify({
                    phone
                })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    closeModalAuth('loginModal');
                    openModalAuth('confirmModal');

                    // Сохраняем номер телефона для отправки в confirm
                    document.getElementById('confirmPhone').value = phone;
                } else {
                    errorElement.textContent = data.error || 'Ошибка';
                }
            })
            .catch(err => {
                errorElement.textContent = 'Произошла ошибка';
            });
    }

    function submitConfirm() {
        const code = document.getElementById('code').value;
        const phone = document.getElementById('confirmPhone').value; // Получаем телефон из скрытого поля
        const errorElement = document.getElementById('confirmError');
        errorElement.textContent = '';

        fetch('/confirm', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-CSRF-TOKEN': document.querySelector('meta[name="csrf-token"]').content
                },
                body: JSON.stringify({
                    phone,
                    code
                })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    closeModalAuth('confirmModal');
                    location.reload();
                } else {
                    errorElement.textContent = data.error || 'Неверный код';
                }
            })
            .catch(err => {
                errorElement.textContent = 'Произошла ошибка';
            });
    }

    document.addEventListener("DOMContentLoaded", function() {
        const phoneInput = document.getElementById('phone');
        Inputmask("+998 (99)-999-99-99", {
            clearMaskOnLostFocus: false
        }).mask(phoneInput);
    });
</script>

