<script>
    $.ajaxSetup({
        headers: {
            'X-CSRF-TOKEN': $('meta[name="csrf-token"]').attr('content')
        }
    });

    $(function () {
        $.datepicker.setDefaults($.datepicker.regional['']);
    });

    $(function () {
        var now = new Date();
        var tomorrow = new Date();
        tomorrow.setDate(tomorrow.getDate() + 1);

        $('#datetimepicker1').datepicker({
            minDate: now,
            onSelect: function () {
                var $startDate = $(this);
                var $endDate = $('#datetimepicker2');
                var startDate = $startDate.datepicker('getDate');
                var endDate = $endDate.datepicker('getDate');

                if (!endDate) {
                    startDate.setDate(startDate.getDate() + 1);
                    $endDate.datepicker('setDate', startDate);
                    return;
                }

                if (startDate >= endDate) {
                    startDate.setDate(startDate.getDate() + 1);
                    $endDate.datepicker('setDate', startDate);
                }
                window.setTimeout($.proxy(function() {
                    $('#datetimepicker2').datepicker("show");
                }, this), 10);
            }
        });
            $('#datetimepicker2').datepicker({
                minDate: tomorrow,
                onSelect: function () {
                    var $endDate = $(this);
                    var $startDate = $('#datetimepicker1');
                    var startDate = $startDate.datepicker('getDate');
                    var endDate = $endDate.datepicker('getDate');

                    if (!startDate) {
                        endDate.setDate(endDate.getDate() - 1);
                        $startDate.datepicker('setDate', endDate);
                        return;
                    }

                    if (endDate <= startDate) {
                        endDate.setDate(endDate.getDate() - 1);
                        $startDate.datepicker('setDate', endDate);
                    }

                }
            });
    });
</script>

<script>
    $(document).ready(function () {
        $('#sortable').DataTable({
            "lengthMenu": [[100], [100]],
            "info":     false,
                        "paging":   false,
                        "order": [[ 1, "asc" ]],
            "filter":     false,
            "oLanguage": {
            "oPaginate": {
                "sFirst": "<<", // This is the link to the first page
                "sPrevious": "<", // This is the link to the previous page
                "sNext": ">", // This is the link to the next page
                "sLast": ">>" // This is the link to the last page
            }
            }
        });
    });
//    $("div.toolbar").html('');
    $(document).ready(function () {
        $("#sortable_length").html('').hide();
        $(".dataTables_empty").html('').hide();
        }
    );


    $(document).ready(function() {
        $('input[name="daterange"]').daterangepicker();
    });

    $(function() {
        // Инициализация диапазона дат
        $('#reservation').daterangepicker({
            locale: {
                format: 'YYYY-MM-DD'
            },
            startDate: moment().startOf('day'),
            endDate: moment().add(1, 'days').startOf('day')
        });
    });
    
    function handleBookNowClick(e) {
        const hasBeginDate = false;
        
        if (!hasBeginDate) {
            e.preventDefault();

            const startDateInput = document.getElementById('startDate');
            if (startDateInput) {
                // Прокрутка до поля (важно для мобильных)
                startDateInput.scrollIntoView({ behavior: 'smooth', block: 'center' });

                // Пауза перед фокусом и flatpickr — помогает на мобильных
                setTimeout(() => {
                    startDateInput.classList.add('active');
                    startDateInput.focus();

                    if (startDateInput._flatpickr) {
                        startDateInput._flatpickr.open();
                    }
                }, 300);
            }
        }
    }

</script>




